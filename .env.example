# Copy this file to .env and fill in values for the provider you select.

# OpenAI
OPENAI_API_KEY="your-openai-key"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-transcribe"

# Groq (OpenAI-compatible)
GROQ_API_KEY="your-groq-key"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="your-groq-model"

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY="your-openrouter-key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="your-openrouter-model"

# xAI (native speech-to-text API, POST /v1/stt)
XAI_API_KEY="your-xai-key"
XAI_BASE_URL="https://api.x.ai/v1"
XAI_MODEL="grok-voice-transcribe-2.0"
